LLAMA_CPP_BASE_URL=http://127.0.0.1:8090
LLAMA_CPP_MODEL=
STT_BACKEND=huggingface
TTS_BACKEND=huggingface
STT_MODEL_ID=
TTS_MODEL_ID=
WHISPER_CPP_BASE_URL=http://127.0.0.1:8080
WHISPER_CPP_INFERENCE_PATH=/inference
PIPER_BINARY=
PIPER_MODEL_PATH=
STT_DEVICE=cuda
TTS_DEVICE=cuda
STT_DTYPE=float16
TTS_DTYPE=float16
AUDIO_MAX_SECONDS=30
AUDIO_MAX_BYTES=10485760
AUDIO_RETENTION_SECONDS=600
LLM_TIMEOUT_SECONDS=60
STT_TIMEOUT_SECONDS=45
TTS_TIMEOUT_SECONDS=45
CORS_ORIGINS=http://localhost:5173
# Folds the 100 approved reference answers into the system prompt.
# Requires llama-server --ctx-size 8192 or larger.
KNOWLEDGE_BASE_ENABLED=true
# Optional override; defaults to backend/app/data/atbk_knowledge_base.json
KNOWLEDGE_BASE_PATH=
# --- Intent engine -----------------------------------------------------------
# Zero-shot routing to the medikal / savaş yönergeleri / matematik / sohbet
# agents, with saat answered locally. Turning this off restores the single
# shared prompt and removes the classifying stage entirely.
INTENT_ENABLED=true
INTENT_BASE_URL=http://127.0.0.1:6006
INTENT_CLASSIFY_PATH=/classify
INTENT_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
INTENT_TIMEOUT_SECONDS=5
# Blank keeps the evaluation set's own guven_esigi (0.25). Below the threshold
# the turn is answered by the default sohbet agent.
INTENT_CONFIDENCE_THRESHOLD=
